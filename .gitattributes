# Line-ending policy.
#
# Only this project's own scripts are normalised; the vendored upstream trees
# (repos/u-boot-rk3128-tvbox, repos/RK3128-Linux-SupportingScripts) are kept
# byte-for-byte as imported, so no pattern here may match paths under repos/.
#
# The build pipeline runs inside the Debian container ("bash /workspace/tools/x.sh"),
# where a stray CR makes the shebang/arguments fail in confusing ways.

/tools/*.sh     text eol=lf
/tools/*/*.sh   text eol=lf
/tools/*.py     text eol=lf
/tools/*/*.py   text eol=lf

# PowerShell helpers are used from Windows only.
/tools/*.ps1    text eol=crlf

# Checksum manifests are fed to sha256sum/Get-FileHash: a stray CR there breaks
# every line ("file\r" not found). Keep them LF everywhere.
/output/SHA256SUMS.txt                   text eol=lf
/output/planb-stock-uboot/SHA256SUMS.txt text eol=lf

# The NAND parameter table must stay byte-identical to the stock A26 file (it is
# checksummed that way in output/SHA256SUMS.txt and flashed at 0x0). That file is
# CRLF, so mark it -text: never convert it.
/output/nand-flash/parameter.txt         -text

# Binary artifacts must never be normalised.
*.img   binary
*.bin   binary
*.deb   binary
*.dtb   binary
*.dtbo  binary
*.gz    binary
*.xz    binary
*.scr   binary
